
# Fractional Knapsack using Greedy Method

def fractional_knapsack(weights, profits, capacity):
    n = len(weights)

    # Calculate profit/weight ratio
    ratio = []
    for i in range(n):
        ratio.append(profits[i] / weights[i])

    # Sort items according to decreasing ratio
    items = sorted(zip(ratio, weights, profits), reverse=True)

    total_profit = 0

    for r, w, p in items:
        if capacity >= w:
            total_profit += p
            capacity -= w
        else:
            total_profit += r * capacity
            break

    return total_profit


# Main Program
weights = [10, 20, 30]
profits = [60, 100, 120]
capacity = 50

max_profit = fractional_knapsack(weights, profits, capacity)

print("Maximum Profit:", max_profit)
